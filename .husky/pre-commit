#!/bin/sh
. "$(dirname "$0")/husky.sh"

echo "🔍 Running lint..."
npm run lint || {
  echo "❌ Lint failed, aborting commit."
  exit 1
}

echo "✅ Lint passed. Running tests..."
npm test || {
  echo "❌ Tests failed, aborting commit."
  exit 1
}

echo "🎉 All checks passed!"

echo "🔖 Bumping app version (patch)..."
npm run version:bump || {
  echo "❌ Version bump failed, aborting commit."
  exit 1
}
git add package.json package-lock.json
echo "✅ Version bumped. Commit successful."

